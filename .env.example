# Copy this file to .env for local development and replace every placeholder.
# Do not commit real secrets, passwords, or production values.

# Shared
NODE_ENV=development

# Backend
PORT=3000
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql://<replace-with-local-postgres-user>:<replace-with-local-postgres-password>@localhost:5432/<replace-with-local-postgres-db>?schema=public
JWT_ACCESS_SECRET=<replace-with-local-jwt-access-secret>
JWT_REFRESH_SECRET=<replace-with-local-jwt-refresh-secret>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend
VITE_API_BASE_URL=http://localhost:3000/api/v1

# PostgreSQL Docker
POSTGRES_DB=<replace-with-local-postgres-db>
POSTGRES_USER=<replace-with-local-postgres-user>
POSTGRES_PASSWORD=<replace-with-local-postgres-password>
