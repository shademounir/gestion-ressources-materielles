generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum RoleName {
  ADMIN
  MANAGER
  USER
  RESOURCE_MANAGER
  DEPARTMENT_HEAD
  TEACHER
  SUPPLIER
  MAINTENANCE_TECHNICIAN
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

enum NeedStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CONVERTED_TO_TENDER
  CANCELLED
}

enum NeedPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum TenderStatus {
  DRAFT
  PUBLISHED
  CLOSED
  AWARDED
  CANCELLED
  ARCHIVED
}

enum SupplierOfferStatus {
  SUBMITTED
  UNDER_REVIEW
  REJECTED
  SELECTED
  WITHDRAWN
}

enum ResourceStatus {
  AVAILABLE
  ASSIGNED
  UNDER_MAINTENANCE
  OUT_OF_SERVICE
  ARCHIVED
}

enum ResourceAssignmentStatus {
  ACTIVE
  RETURNED
  CANCELLED
}

enum MaintenanceTicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  CANCELLED
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MaintenanceSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Role {
  id          String   @id @default(uuid())
  name        RoleName @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Department {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  status      DepartmentStatus @default(ACTIVE)
  users       User[]
  needs       Need[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
}

model User {
  id                         String               @id @default(uuid())
  email                      String               @unique
  passwordHash               String
  firstName                  String
  lastName                   String
  status                     UserStatus           @default(ACTIVE)
  roleId                     String
  role                       Role                 @relation(fields: [roleId], references: [id])
  departmentId               String?
  department                 Department?          @relation(fields: [departmentId], references: [id])
  auditLogs                  AuditLog[]
  createdNeeds               Need[]               @relation("NeedCreatedBy")
  createdTenders             Tender[]             @relation("TenderCreatedBy")
  resourceAssignments        ResourceAssignment[]
  reportedMaintenanceTickets MaintenanceTicket[]  @relation("MaintenanceTicketReportedBy")
  authoredMaintenanceReports MaintenanceReport[]  @relation("MaintenanceReportAuthor")
  createdAt                  DateTime             @default(now())
  updatedAt                  DateTime             @updatedAt
  deletedAt                  DateTime?

  @@index([email])
  @@index([roleId])
  @@index([departmentId])
}

model Need {
  id            String       @id @default(uuid())
  title         String
  justification String
  priority      NeedPriority
  status        NeedStatus   @default(SUBMITTED)
  departmentId  String
  department    Department   @relation(fields: [departmentId], references: [id])
  createdById   String
  createdBy     User         @relation("NeedCreatedBy", fields: [createdById], references: [id])
  items         NeedItem[]
  tenders       Tender[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([departmentId])
  @@index([createdById])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model NeedItem {
  id                 String   @id @default(uuid())
  needId             String
  need               Need     @relation(fields: [needId], references: [id], onDelete: Cascade)
  designation        String
  description        String?
  quantity           Int
  estimatedUnitPrice Decimal?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([needId])
}

model Supplier {
  id           String          @id @default(uuid())
  name         String          @unique
  contactEmail String?         @unique
  phone        String?
  address      String?
  status       SupplierStatus  @default(ACTIVE)
  offers       SupplierOffer[]
  resources    Resource[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([name])
  @@index([contactEmail])
  @@index([status])
}

model Tender {
  id          String          @id @default(uuid())
  reference   String          @unique
  title       String
  description String
  status      TenderStatus    @default(DRAFT)
  deadline    DateTime
  publishedAt DateTime?
  awardedAt   DateTime?
  needId      String
  need        Need            @relation(fields: [needId], references: [id])
  createdById String
  createdBy   User            @relation("TenderCreatedBy", fields: [createdById], references: [id])
  offers      SupplierOffer[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([needId])
  @@index([createdById])
  @@index([status])
  @@index([deadline])
}

model SupplierOffer {
  id                   String              @id @default(uuid())
  tenderId             String
  tender               Tender              @relation(fields: [tenderId], references: [id])
  supplierId           String
  supplier             Supplier            @relation(fields: [supplierId], references: [id])
  amount               Decimal
  proposedDeliveryDays Int
  comment              String?
  status               SupplierOfferStatus @default(SUBMITTED)
  submittedAt          DateTime            @default(now())
  selectedAt           DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([tenderId, supplierId])
  @@index([tenderId])
  @@index([supplierId])
  @@index([status])
  @@index([submittedAt])
}

model Resource {
  id                 String               @id @default(uuid())
  name               String
  inventoryCode      String               @unique
  category           String
  description        String?
  serialNumber       String?
  acquisitionDate    DateTime?
  acquisitionValue   Decimal?
  status             ResourceStatus       @default(AVAILABLE)
  supplierId         String?
  supplier           Supplier?            @relation(fields: [supplierId], references: [id])
  assignments        ResourceAssignment[]
  maintenanceTickets MaintenanceTicket[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([inventoryCode])
  @@index([category])
  @@index([status])
  @@index([supplierId])
  @@index([createdAt])
}

model ResourceAssignment {
  id            String                   @id @default(uuid())
  resourceId    String
  resource      Resource                 @relation(fields: [resourceId], references: [id])
  userId        String
  user          User                     @relation(fields: [userId], references: [id])
  assignedAt    DateTime                 @default(now())
  returnedAt    DateTime?
  status        ResourceAssignmentStatus @default(ACTIVE)
  comment       String?
  returnComment String?
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  @@index([resourceId])
  @@index([userId])
  @@index([status])
  @@index([assignedAt])
}

model MaintenanceTicket {
  id           String                  @id @default(uuid())
  resourceId   String
  resource     Resource                @relation(fields: [resourceId], references: [id])
  reportedById String
  reportedBy   User                    @relation("MaintenanceTicketReportedBy", fields: [reportedById], references: [id])
  description  String
  priority     MaintenancePriority
  status       MaintenanceTicketStatus @default(OPEN)
  openedAt     DateTime                @default(now())
  closedAt     DateTime?
  report       MaintenanceReport?
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([resourceId])
  @@index([reportedById])
  @@index([priority])
  @@index([status])
  @@index([openedAt])
}

model MaintenanceReport {
  id                  String              @id @default(uuid())
  maintenanceTicketId String              @unique
  maintenanceTicket   MaintenanceTicket   @relation(fields: [maintenanceTicketId], references: [id])
  authorId            String
  author              User                @relation("MaintenanceReportAuthor", fields: [authorId], references: [id])
  diagnosis           String
  probableCause       String
  severity            MaintenanceSeverity
  recommendations     String?
  reportedAt          DateTime            @default(now())
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([authorId])
  @@index([severity])
  @@index([reportedAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}
