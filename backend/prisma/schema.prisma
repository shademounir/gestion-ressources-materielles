generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  INACTIVE
  LOCKED
}

enum RoleName {
  ADMIN
  MANAGER
  USER
  RESOURCE_MANAGER
  DEPARTMENT_HEAD
  TEACHER
  SUPPLIER
  MAINTENANCE_TECHNICIAN
}

enum DepartmentStatus {
  ACTIVE
  INACTIVE
}

enum NeedStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CONVERTED_TO_TENDER
  CANCELLED
}

enum NeedPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum TenderStatus {
  DRAFT
  PUBLISHED
  CLOSED
  AWARDED
  CANCELLED
  ARCHIVED
}

model Role {
  id          String   @id @default(uuid())
  name        RoleName @unique
  description String?
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Department {
  id          String           @id @default(uuid())
  name        String           @unique
  description String?
  status      DepartmentStatus @default(ACTIVE)
  users       User[]
  needs       Need[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  deletedAt   DateTime?
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  passwordHash String
  firstName    String
  lastName     String
  status       UserStatus @default(ACTIVE)
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  departmentId String?
  department   Department? @relation(fields: [departmentId], references: [id])
  auditLogs    AuditLog[]
  createdNeeds Need[]      @relation("NeedCreatedBy")
  createdTenders Tender[]  @relation("TenderCreatedBy")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  @@index([email])
  @@index([roleId])
  @@index([departmentId])
}

model Need {
  id            String       @id @default(uuid())
  title         String
  justification String
  priority      NeedPriority
  status        NeedStatus   @default(SUBMITTED)
  departmentId  String
  department    Department   @relation(fields: [departmentId], references: [id])
  createdById   String
  createdBy     User         @relation("NeedCreatedBy", fields: [createdById], references: [id])
  items         NeedItem[]
  tenders       Tender[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([departmentId])
  @@index([createdById])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
}

model NeedItem {
  id                 String   @id @default(uuid())
  needId             String
  need               Need     @relation(fields: [needId], references: [id], onDelete: Cascade)
  designation        String
  description        String?
  quantity           Int
  estimatedUnitPrice Decimal?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([needId])
}

model Supplier {
  id           String         @id @default(uuid())
  name         String         @unique
  contactEmail String?        @unique
  phone        String?
  address      String?
  status       SupplierStatus @default(ACTIVE)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([name])
  @@index([contactEmail])
  @@index([status])
}

model Tender {
  id          String       @id @default(uuid())
  reference   String       @unique
  title       String
  description String
  status      TenderStatus @default(DRAFT)
  deadline    DateTime
  publishedAt DateTime?
  needId      String
  need        Need         @relation(fields: [needId], references: [id])
  createdById String
  createdBy   User         @relation("TenderCreatedBy", fields: [createdById], references: [id])
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([needId])
  @@index([createdById])
  @@index([status])
  @@index([deadline])
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?
  actor      User?    @relation(fields: [actorId], references: [id])
  action     String
  targetType String
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([targetType, targetId])
  @@index([createdAt])
}
