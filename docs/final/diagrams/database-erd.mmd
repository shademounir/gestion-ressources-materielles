erDiagram
  ROLE ||--o{ USER : grants
  DEPARTMENT ||--o{ USER : contains
  DEPARTMENT ||--o{ NEED : owns
  USER ||--o{ NEED : creates
  NEED ||--|{ NEED_ITEM : contains
