    string id PK
    string reference UK
    string title
    TenderStatus status
    datetime deadline
  }
  SUPPLIER_OFFER {
    string id PK
    decimal amount
    int proposedDeliveryDays
    SupplierOfferStatus status
  }
  MAINTENANCE_TICKET {
    string id PK
    MaintenancePriority priority
    MaintenanceTicketStatus status
  }
