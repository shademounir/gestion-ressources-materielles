    ROLE {
        string id PK
        RoleName name UK
        string description
    }
    USER {
        string id PK
        string email UK
        string passwordHash
        UserStatus status
        string roleId FK
        string departmentId FK
    }
    DEPARTMENT {
        string id PK
        string name UK
        DepartmentStatus status
        datetime deletedAt
    }
    NEED {
        string id PK
        string title
        NeedPriority priority
        NeedStatus status
        string departmentId FK
        string createdById FK
    }
    NEED_ITEM {
        string id PK
        string needId FK
        string designation
        int quantity
        decimal estimatedUnitPrice
    }
    TENDER {
        string id PK
        string reference UK
        TenderStatus status
        datetime deadline
        datetime publishedAt
        datetime awardedAt
        string needId FK
        string createdById FK
    }
    SUPPLIER_OFFER {
        string id PK
        string tenderId FK
        string supplierId FK
        decimal amount
        SupplierOfferStatus status
        datetime selectedAt
    }
    SUPPLIER {
        string id PK
        string name UK
        string contactEmail UK
        SupplierStatus status
    }
    RESOURCE {
        string id PK
        string inventoryCode UK
        string category
        ResourceStatus status
        string supplierId FK
    }
    RESOURCE_ASSIGNMENT {
        string id PK
        string resourceId FK
        string userId FK
        ResourceAssignmentStatus status
        datetime assignedAt
        datetime returnedAt
    }
    MAINTENANCE_TICKET {
        string id PK
        string resourceId FK
        string reportedById FK
        MaintenancePriority priority
        MaintenanceTicketStatus status
    }
    MAINTENANCE_REPORT {
        string id PK
        string maintenanceTicketId FK
        string authorId FK
        MaintenanceSeverity severity
    }
    MAINTENANCE_INTERVENTION {
        string id PK
        string maintenanceTicketId FK
        string technicianName
        datetime startedAt
        datetime completedAt
    }
    SUPPLIER_RETURN {
        string id PK
        string maintenanceTicketId FK
        string resourceId FK
        string supplierId FK
        SupplierReturnStatus status
    }
    NOTIFICATION {
        string id PK
        string recipientId FK
        NotificationType type
        NotificationEntityType entityType
        datetime readAt
    }
    AUDIT_LOG {
        string id PK
        string userId FK
        AuditAction action
        AuditEntityType entityType
        json details
    }
