erDiagram
    ROLE ||--o{ USER : has
    DEPARTMENT ||--o{ USER : contains
    DEPARTMENT ||--o{ NEED : owns
    USER ||--o{ NEED : creates
    NEED ||--o{ NEED_ITEM : contains
    NEED ||--o{ TENDER : generates
    USER ||--o{ TENDER : creates
    TENDER ||--o{ SUPPLIER_OFFER : receives
    SUPPLIER ||--o{ SUPPLIER_OFFER : submits
    SUPPLIER ||--o{ RESOURCE : provides
    RESOURCE ||--o{ RESOURCE_ASSIGNMENT : assigned_as
    USER ||--o{ RESOURCE_ASSIGNMENT : receives
